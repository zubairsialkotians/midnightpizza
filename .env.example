# Midnight Pizza — one .env per shop's copy of the app
EXPO_PUBLIC_APP_NAME=Midnight Pizza
EXPO_PUBLIC_API_BASE=https://sialkotians.com
# WP admin → Users → the shop's owner profile → "Shop key"  (create a new Shop App Owner for Midnight Pizza)
EXPO_PUBLIC_SHOP_KEY=
# Brand from the logo: warm midnight black fills with cream text
EXPO_PUBLIC_PRIMARY_COLOR="#1c1a17"
EXPO_PUBLIC_ON_BRAND_COLOR="#efe6c4"

# Native app identity (used by app.config.js)
APP_NAME=Midnight Pizza
APP_SLUG=midnightpizza
APP_BUNDLE_ID=mid.night.pizza
# Logo has a black background
APP_ICON_BACKGROUND="#000000"

# Push notifications: EAS project id (npx eas init) and google-services.json for APP_BUNDLE_ID
EAS_PROJECT_ID=
GOOGLE_SERVICES_FILE=./google-services.json
